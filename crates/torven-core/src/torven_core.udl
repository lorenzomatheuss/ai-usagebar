// torven_core.udl — Torven Core FFI surface declaration.
//
// This file declares every Rust function, type, enum, and callback interface
// that crosses the Swift <-> Rust FFI boundary. Generated by UniFFI 0.27 at
// build time (see `build.rs`). The Swift bindings are produced by
// `uniffi-bindgen generate --language swift` and consumed by the SwiftUI app
// in `apple/Torven/`.
//
// Architecture reference: docs/architecture/torven-v1-adr.md#adr-4
//
// ---------------------------------------------------------------------------
// Type conventions (MUST follow across every function added to this UDL):
// ---------------------------------------------------------------------------
//
// * Primitives:  string, i32, i64, f64, boolean
// * Timestamps:  always i64 representing Unix epoch milliseconds.
//                Convert to Date on the Swift side and to DateTime<Utc> on
//                the Rust side. Never expose chrono types directly.
// * Monetary:    always f64 representing US dollars. Vendors return USD;
//                if a future vendor returns a different currency, normalize
//                in Rust before crossing FFI.
// * Optional:    `T?` (nullable). Maps to Swift `T?` and Rust `Option<T>`.
// * Lists:       `sequence<T>`. Prefer batched/paginated APIs (e.g.
//                `list_snapshots(limit: i32)`) over `get_all_*` to avoid
//                large allocations crossing FFI (see AR-3 in ADR).
// * Errors:      define a UDL `enum` of error variants and tag the function
//                with `[Throws=ErrorType]`. Maps to Swift `throws` and Rust
//                `Result<T, ErrorType>`.
// * Strings:     always UTF-8. See SECURITY note below.
// * Async:       use `[Async]` annotation (UniFFI 0.25+) when the Rust impl
//                is `async fn`. Required for streaming endpoints
//                (Story 1.15 — AI Insights).
//
// ---------------------------------------------------------------------------
// SECURITY (NON-NEGOTIABLE):
// ---------------------------------------------------------------------------
// NEVER expose `api_key`, OAuth tokens, refresh tokens, or any user secret
// through this FFI surface as a `string`. Secrets MUST be persisted via the
// Keychain helpers (`keychain_get_blob` / `keychain_set_blob` — added in a
// later story) and referenced by opaque vendor + account IDs in the FFI.
// Strings crossing FFI are eligible to appear in crash logs, telemetry, and
// developer dumps.
// ---------------------------------------------------------------------------

// VendorInfo — minimal metadata for a single LLM vendor.
//
// This is the first non-trivial Rust struct exposed to Swift through the FFI.
// It validates the type-marshalling path for `dictionary` (struct/record) and
// `sequence<T>` (Vec<T>) and serves as the canonical shape for vendor lists in
// the menu-bar app.
//
// Field rules:
//   * `id`              — stable lowercase slug (e.g. "anthropic"); used as
//                         the lookup key in config and the keychain account
//                         namespace. NEVER user-facing.
//   * `display_name`    — UTF-8 human-readable label for the UI.
//                         Free-form, vendor-controlled branding string.
//   * `is_configured`   — true when the user has provided credentials for the
//                         vendor and they passed the most recent validation.
//                         Story 1.5 hardcodes this to `false` for all vendors;
//                         Story 1.6 wires it to the real config probe.
//
// AR-3 (memory ownership): every field is owned by value on the Rust side and
// transferred to Swift through UniFFI's normal reference-counted struct
// pathway. The spike in Story 1.5 (see Change Log) validates that returning a
// `sequence<VendorInfo>` from `get_vendor_list()` 100 times under `leaks`
// produces zero leaked allocations.
dictionary VendorInfo {
    string id;
    string display_name;
    boolean is_configured;
};

dictionary HistorySnapshot {
    i64 id;
    string vendor;
    string? account_id;
    i64 ts;
    f64? cost_usd;
    i64? tokens_used;
    f64? pct_used;
    string metric_kind;
};

enum HistoryFfiError {
    "NotInitialized",
    "Storage",
};

namespace torven_core {
    // Smoke-test function — validates that the Rust -> FFI -> Swift pipeline
    // is wired correctly end-to-end before any real business surface is
    // added. Returns the constant string "pong".
    //
    // This is the AR-1 spike validation function (see Story 1.2). It will be
    // kept long-term as a no-op health check that the SwiftUI app can call on
    // launch to confirm the bundled XCFramework loaded successfully.
    string ping();

    // Returns the canonical list of LLM vendors Torven knows about. Story 1.5
    // hardcodes all 5 vendors with `is_configured = false`; Story 1.6 swaps
    // this for a config-driven implementation that probes the user's
    // `config.toml` to determine which vendors actually have credentials.
    //
    // Order is significant: the menu-bar app renders vendors in the order
    // returned here. Current order matches the rollout / market-share
    // priority used in the legacy Waybar widget (Anthropic first, OpenAI
    // second, then OpenRouter, Z.AI, Gemini).
    sequence<VendorInfo> get_vendor_list();

    // Initializes the Rust-owned SQLite history database. If `db_path` is not
    // provided, Rust uses ~/Library/Application Support/Torven/history.db on
    // macOS. Swift must not access SQLite directly; every history read/write
    // crosses this FFI boundary.
    [Throws=HistoryFfiError]
    void ffi_init_history(string? db_path);

    [Throws=HistoryFfiError]
    sequence<HistorySnapshot> ffi_query_snapshots(
        string vendor,
        string? account_id,
        i64 since_ts,
        i64 until_ts
    );

    [Throws=HistoryFfiError]
    void ffi_record_snapshot(HistorySnapshot snapshot);

    [Throws=HistoryFfiError]
    void ffi_run_retention_janitor(u32 retention_days);
};
