// torven_core.udl — Torven Core FFI surface declaration.
//
// This file declares every Rust function, type, enum, and callback interface
// that crosses the Swift <-> Rust FFI boundary. Generated by UniFFI 0.27 at
// build time (see `build.rs`). The Swift bindings are produced by
// `uniffi-bindgen generate --language swift` and consumed by the SwiftUI app
// in `apple/Torven/`.
//
// Architecture reference: docs/architecture/torven-v1-adr.md#adr-4
//
// ---------------------------------------------------------------------------
// Type conventions (MUST follow across every function added to this UDL):
// ---------------------------------------------------------------------------
//
// * Primitives:  string, i32, i64, f64, boolean
// * Timestamps:  always i64 representing Unix epoch milliseconds.
//                Convert to Date on the Swift side and to DateTime<Utc> on
//                the Rust side. Never expose chrono types directly.
// * Monetary:    always f64 representing US dollars. Vendors return USD;
//                if a future vendor returns a different currency, normalize
//                in Rust before crossing FFI.
// * Optional:    `T?` (nullable). Maps to Swift `T?` and Rust `Option<T>`.
// * Lists:       `sequence<T>`. Prefer batched/paginated APIs (e.g.
//                `list_snapshots(limit: i32)`) over `get_all_*` to avoid
//                large allocations crossing FFI (see AR-3 in ADR).
// * Errors:      define a UDL `enum` of error variants and tag the function
//                with `[Throws=ErrorType]`. Maps to Swift `throws` and Rust
//                `Result<T, ErrorType>`.
// * Strings:     always UTF-8. See SECURITY note below.
// * Async:       use `[Async]` annotation (UniFFI 0.25+) when the Rust impl
//                is `async fn`. Required for streaming endpoints
//                (Story 1.15 — AI Insights).
//
// ---------------------------------------------------------------------------
// SECURITY (NON-NEGOTIABLE):
// ---------------------------------------------------------------------------
// NEVER expose `api_key`, OAuth tokens, refresh tokens, or any user secret
// through this FFI surface as a `string`. Secrets MUST be persisted via the
// Keychain helpers (`keychain_get_blob` / `keychain_set_blob` — added in a
// later story) and referenced by opaque vendor + account IDs in the FFI.
// Strings crossing FFI are eligible to appear in crash logs, telemetry, and
// developer dumps.
// ---------------------------------------------------------------------------

// VendorInfo — minimal metadata for a single LLM vendor.
//
// This is the first non-trivial Rust struct exposed to Swift through the FFI.
// It validates the type-marshalling path for `dictionary` (struct/record) and
// `sequence<T>` (Vec<T>) and serves as the canonical shape for vendor lists in
// the menu-bar app.
//
// Field rules:
//   * `id`              — stable lowercase slug (e.g. "anthropic"); used as
//                         the lookup key in config and the keychain account
//                         namespace. NEVER user-facing.
//   * `display_name`    — UTF-8 human-readable label for the UI.
//                         Free-form, vendor-controlled branding string.
//   * `is_configured`   — true when the user has provided credentials for the
//                         vendor and they passed the most recent validation.
//                         Story 1.5 hardcodes this to `false` for all vendors;
//                         Story 1.6 wires it to the real config probe.
//
// AR-3 (memory ownership): every field is owned by value on the Rust side and
// transferred to Swift through UniFFI's normal reference-counted struct
// pathway. The spike in Story 1.5 (see Change Log) validates that returning a
// `sequence<VendorInfo>` from `get_vendor_list()` 100 times under `leaks`
// produces zero leaked allocations.
dictionary VendorInfo {
    string id;
    string display_name;
    boolean is_configured;
};

// AccountInfo — single account row for the per-vendor account picker.
//
// Story 3.3 (Wave 3) introduces this dictionary so the SwiftUI AccountPicker
// can list the credentials a user configured for a multi-account vendor
// (OpenRouter, Z.AI). The active marker is owned by an in-memory cache in
// `uniffi_exports.rs` for Wave 3; Wave 4+ may persist it to `config.toml`.
//
// SECURITY: `id` and `label` are non-secret. The `id` is the deterministic
// `account_id(vendor, name)` from `config.rs` (e.g. "openrouter-clienteacme"),
// safe to log and surface in UI. NEVER add `api_key` or any credential
// material to this dictionary — secrets live exclusively in the Keychain
// (Story 1.20) and are referenced by `id` opaquely.
dictionary AccountInfo {
    string id;
    string label;
    boolean is_active;
};

dictionary HistorySnapshot {
    i64 id;
    string vendor;
    string? account_id;
    i64 ts;
    f64? cost_usd;
    i64? tokens_used;
    f64? pct_used;
    string metric_kind;
};

dictionary UsageSnapshotInput {
    string vendor;
    string? account_id;
    i64 ts;
    f64? cost_usd;
    i64? tokens_used;
    f64? pct_used;
    string metric_kind;
};

dictionary PagedHistorySnapshots {
    sequence<HistorySnapshot> items;
    string? next_cursor;
};

// TimeBucket — Story 4.0.5 (Wave 4). Single row of temporally-bucketed usage
// aggregation, computed in SQLite via `GROUP BY (ts / bucket_size_ms)`. Used
// by `ffi_query_aggregated` to feed Swift Charts (Stories 4.3, 4.4, 4.5).
//
// Field semantics (see Story 4.0.5 §AC-1, AC-5):
//   * `bucket_start_ts`  — Unix ms, inclusive. Lower bound of the bucket.
//   * `bucket_end_ts`    — Unix ms, exclusive. Always
//                          `bucket_start_ts + bucket_size_ms`.
//   * `account_id`       — Some when `account_filter_mode = Specific`;
//                          None when `All` or `Null` (aggregated across
//                          accounts, or filtered to NULL-account rows).
//   * `metric_kind`      — preserved verbatim from `usage_snapshots.metric_kind`.
//                          Vendors emit `cost_usd_total`, `tokens_used`, or
//                          `pct_used` heterogeneously; `metric_kind` is part
//                          of the GROUP BY key so heterogeneous buckets are
//                          never silently merged.
dictionary TimeBucket {
    i64 bucket_start_ts;
    i64 bucket_end_ts;
    string vendor;
    string? account_id;
    f64 cost_sum_usd;
    u64 tokens_sum;
    u32 request_count;
    string metric_kind;
};

enum HistoryAccountFilterMode {
    "All",
    "Null",
    "Specific",
};

// BucketStrategy — Story 4.0.5 (Wave 4). Selects the bucket width for
// `ffi_query_aggregated`. `Auto` derives the width from the requested range
// so the number of buckets stays bounded for Swift Charts performance
// (NFR-1, AR-8): ≤7d → Hourly, ≤30d → Daily, otherwise Weekly.
enum BucketStrategy {
    "Auto",
    "Hourly",
    "Daily",
    "Weekly",
};

enum HistoryFfiError {
    "NotInitialized",
    "Storage",
};

enum KeychainFfiError {
    "Storage",
};

// AccountFfiError — Story 3.3 (Wave 3) — surface for `set_active_account`.
// VendorNotFound: caller passed a vendor_id slug not recognized by the core.
// AccountNotFound: vendor exists but no account with the given id is configured.
// Storage: failure reading config.toml or writing the in-memory active map.
enum AccountFfiError {
    "VendorNotFound",
    "AccountNotFound",
    "Storage",
};

// RefreshFfiError — Story 5.1 (Wave 5) — surface for `ffi_refresh_vendor`.
// One variant per logical failure category so Swift can render a precise
// status message (and Story 5.3 can decide between "re-auth", "retry", and
// "ignore" affordances). The mapping from internal errors is intentionally
// granular:
//
//   * CredentialMissing — Keychain blob absent (no account configured) or
//     OAuth credentials file (`~/.claude/.credentials.json`,
//     `~/.codex/auth.json`) does not exist. Distinct from NetworkError so
//     the UI can prompt the user to configure Settings (Story 5.2).
//   * NetworkError      — transport-layer failure (DNS, TLS, timeout,
//     connection refused). Maps to AppError::Transport, which is the
//     `is_transient()` bucket — Story 5.3 surfaces this as "retry".
//   * ApiError          — non-2xx HTTP response. Vendor reached but
//     returned 4xx/5xx (rate limit, auth expired, server outage).
//   * ParseFailure      — 2xx but response shape unexpected. Signals
//     undocumented-endpoint drift; loggable but not actionable for users.
//   * StorageError      — `ffi_record_snapshot` failed (history.db
//     uninitialized or SQLite I/O error).
enum RefreshFfiError {
    "CredentialMissing",
    "NetworkError",
    "ApiError",
    "ParseFailure",
    "StorageError",
};

// ---------------------------------------------------------------------------
// Story 4.6 (Wave 4) — Budget burn surface.
//
// `get_budget_status` reads the optional `[budgets]` section from
// `~/.config/torven/config.toml` and aggregates the current calendar month's
// spending (server-side in Rust via SQLite). Swift renders the result through
// `BudgetBurn.swift` as a gauge with verde/amarelo/vermelho thresholds.
//
// Risk #4 mitigation (from Story 4.6 doc): we MUST NOT expose
// `HashMap<String, f64>` directly across UDL — uniffi does not generate a
// stable Swift mapping for HashMap-of-primitives. Instead, the per-vendor
// breakdown is a `sequence<VendorBudgetStatus>` (a vec of records). This is
// the same pattern used by `sequence<VendorInfo>` (Story 1.5) and
// `sequence<TimeBucket>` (Story 4.0.5).
//
// `monthly_usd_total` is nullable (`f64?`) because the user may configure
// only per-vendor caps without a global cap. Maps to `Double?` in Swift.
// ---------------------------------------------------------------------------

dictionary VendorBudgetStatus {
    string vendor_id;
    f64 spent_usd;
    f64 budget_usd;
    f64 percent_used;
};

dictionary BudgetStatus {
    f64 total_spent_usd;
    f64? total_budget_usd;
    f64 total_percent_used;
    sequence<VendorBudgetStatus> per_vendor;
    boolean has_budget;
};

// ---------------------------------------------------------------------------
// Story 1.15 — AI Insights surface (AR-2 resolution §Decision 1).
// ---------------------------------------------------------------------------

// Error enum for the AI Insights subsystem.
//
// `Cancelled` is required by the cancellation strategy (AR-2 resolution
// §Decision 3): the `[Async]` future resolves with `Err(Cancelled)` when
// the Swift caller invokes `CancelHandle::cancel()` mid-stream.
[Error]
enum InsightsError {
    "Network",
    "Auth",
    "RateLimit",
    "InputBudgetExceeded",
    "Timeout",
    "Cancelled",
    "ParseFailure",
    "SchemaInvalid",
};

// Per-vendor numeric aggregate sent to Anthropic. PRD §6.5 privacy
// invariants apply — account_id is the hashed form, never plaintext.
dictionary VendorAggregate {
    string vendor_id;
    string? account_id;
    u64 total_tokens;
    f64 total_cost_usd;
    u32 window_days;
    sequence<u64> daily_tokens;
    sequence<f64> daily_cost_usd;
    string? tag;
};

dictionary InsightsContext {
    sequence<VendorAggregate> usage_payload;
    u32 since_days;
    string prompt_version;
};

enum InsightItemType {
    "Trend",
    "Anomaly",
    "BudgetRisk",
    "OptimizationOpportunity",
};

enum InsightSeverity {
    "Info",
    "Warning",
    "Critical",
};

dictionary InsightItem {
    InsightItemType type_;
    InsightSeverity severity;
    string message;
    string evidence;
};

dictionary InsightsOutput {
    string headline;
    sequence<InsightItem> insights;
    string recommendation;
    f64 cost_usd;
    i64 latency_ms;
    string prompt_version;
};

// Streaming callback invoked from inside the Rust client for each partial
// JSON token chunk. The final InsightsOutput is the Future's return value
// (AR-2 resolution §Decision 1) — there is no on_done method.
callback interface InsightsCallback {
    void on_token(string token);
    void on_error(string error);
};

// Cancellation handle for in-flight insight requests (AR-2 resolution
// §Decision 3). Swift constructs one per request, passes it into
// `request_insight_streaming`, and calls `cancel()` on popover dismiss.
// Internally backed by `tokio_util::sync::CancellationToken`; the Rust
// streaming loop races `tokio::select!` against `token.cancelled()`.
interface CancelHandle {
    constructor();
    void cancel();
    boolean is_cancelled();
};

// Production AI Insights client. Holds an Anthropic API key (sourced
// from the Keychain blob on the Swift side and crossed once at
// construction time per the SECURITY note above) and exposes the
// streaming entry point.
//
// The `[Async]` method is what AR-2 resolution §Decision 1 binds: the
// future resolves with the final structured `InsightsOutput` on
// `message_stop`; partial JSON chunks arrive token-by-token via
// `callback.on_token`. `cancel_handle.cancel()` from Swift causes the
// future to resolve `Err(Cancelled)` within the latency budget proven
// by the AR-2 spike (p99 < 100ms).
//
// UDL-mode + `[Async]` + callback-interface + interface-typed argument
// is a valid combination in UniFFI 0.29 (see
// docs/architecture/ar-2-spike-resolution.md §Decision 1). The Rust
// impl bridges into a tokio context via `async_compat::Compat` so the
// reqwest streaming + `tokio::select!` cancellation race work inside
// UniFFI's polling driver (UDL mode does not pass `async_runtime` to
// the proc-macro scaffolding, so we wrap manually).
interface InsightsClient {
    constructor(string api_key);

    [Async, Throws=InsightsError]
    InsightsOutput request_insight_streaming(
        InsightsContext context,
        InsightsCallback callback,
        CancelHandle cancel_handle
    );
};

namespace torven_core {
    // Smoke-test function — validates that the Rust -> FFI -> Swift pipeline
    // is wired correctly end-to-end before any real business surface is
    // added. Returns the constant string "pong".
    //
    // This is the AR-1 spike validation function (see Story 1.2). It will be
    // kept long-term as a no-op health check that the SwiftUI app can call on
    // launch to confirm the bundled XCFramework loaded successfully.
    string ping();

    // Returns the canonical list of LLM vendors Torven knows about. Story 1.5
    // hardcodes all 5 vendors with `is_configured = false`; Story 1.6 swaps
    // this for a config-driven implementation that probes the user's
    // `config.toml` to determine which vendors actually have credentials.
    //
    // Order is significant: the menu-bar app renders vendors in the order
    // returned here. Current order matches the rollout / market-share
    // priority used in the legacy Waybar widget (Anthropic first, OpenAI
    // second, then OpenRouter, Z.AI, Gemini).
    sequence<VendorInfo> get_vendor_list();

    // Initializes the Rust-owned SQLite history database. If `db_path` is not
    // provided, Rust uses ~/Library/Application Support/Torven/history.db on
    // macOS. Swift must not access SQLite directly; every history read/write
    // crosses this FFI boundary.
    [Throws=HistoryFfiError]
    void ffi_init_history(string? db_path);

    [Throws=HistoryFfiError]
    PagedHistorySnapshots ffi_query_snapshots(
        string vendor,
        HistoryAccountFilterMode account_filter_mode,
        string? account_id,
        i64 since_ts,
        i64 until_ts,
        i64 limit,
        string? cursor
    );

    [Throws=HistoryFfiError]
    i64 ffi_record_snapshot(UsageSnapshotInput snapshot);

    [Throws=HistoryFfiError]
    void ffi_run_retention_janitor(u32 retention_days);

    // Story 4.0.5 (Wave 4) — temporal-bucket aggregation. SQLite computes
    // `SUM(cost_usd) / SUM(tokens_used) / COUNT(*)` grouped by
    // `(ts / bucket_size_ms, vendor, account_id, metric_kind)`, so the Swift
    // Charts consumers (Stories 4.3/4.4/4.5) never have to client-side
    // aggregate the ~43K events of a 30-day window (NFR-1 perf budget).
    //
    // Parameters:
    //   * `vendor`              — vendor slug (e.g. "anthropic"). Empty string
    //                              means "all vendors".
    //   * `account_filter_mode` — `All` aggregates across accounts (returned
    //                              `account_id` is null); `Null` filters to
    //                              rows with NULL `account_id`; `Specific`
    //                              filters to the `account_id` argument.
    //   * `account_id`          — only consulted when mode = `Specific`.
    //   * `since_ts`/`until_ts` — Unix ms window. `[since_ts, until_ts)`
    //                              (since inclusive, until exclusive).
    //   * `bucket_strategy`     — see `BucketStrategy`. `Auto` picks
    //                              Hourly/Daily/Weekly from the range width.
    //
    // Returns buckets ordered ASC by `bucket_start_ts`. Buckets with zero
    // matching rows are omitted; an empty range returns `[]`, not an error.
    [Throws=HistoryFfiError]
    sequence<TimeBucket> ffi_query_aggregated(
        string vendor,
        HistoryAccountFilterMode account_filter_mode,
        string? account_id,
        i64 since_ts,
        i64 until_ts,
        BucketStrategy bucket_strategy
    );

    // Keychain blob helpers. The blob bytes are versioned JSON owned by
    // torven-core and intentionally cross the FFI as bytes, not strings.
    [Throws=KeychainFfiError]
    sequence<u8> ffi_keychain_get_blob(string vendor);

    [Throws=KeychainFfiError]
    void ffi_keychain_set_blob(string vendor, sequence<u8> blob);

    // Story 3.3 (Wave 3) — Account picker FFI surface.
    //
    // `get_accounts_for_vendor` returns the configured `AccountInfo` rows for
    // the given vendor slug (e.g. "openrouter"). Vendors without multi-account
    // support (Anthropic, OpenAI, Gemini in v1.0) return an empty sequence —
    // not an error — so the AccountPicker can render an "Only 1 account
    // configured" affordance without special-casing per vendor in Swift.
    //
    // `is_active` reflects the in-memory active account map maintained by
    // `uniffi_exports.rs`. The first call after process start defaults to
    // the first account in the vendor's `Vec<Account>` (per config.toml
    // order); subsequent `set_active_account` calls update the map.
    // Persistence to TOML is intentionally deferred to Wave 4.
    sequence<AccountInfo> get_accounts_for_vendor(string vendor_id);

    // `set_active_account` swaps the in-memory active account for `vendor_id`
    // to `account_id`. Validates that both exist; raises `VendorNotFound`
    // or `AccountNotFound` otherwise. Storage errors (config.toml read
    // failure, poisoned mutex) surface as `Storage`.
    [Throws=AccountFfiError]
    void set_active_account(string vendor_id, string account_id);

    // Story 5.1 (Wave 5) — On-demand vendor refresh.
    //
    // Executes the vendor's fetcher end-to-end (credential lookup → HTTP
    // request → response parse → snapshot write to `usage_snapshots`). Used
    // by the Refresh button (Story 5.3) and, later, by an auto-refresh
    // scheduler (Wave 5.5).
    //
    // `vendor_name` accepts the canonical slugs: "anthropic", "openai",
    // "openrouter", "zai". Unknown slugs return `CredentialMissing` (and
    // emit a `tracing::warn!` for diagnostics) rather than crashing.
    //
    // Authentication source by vendor:
    //   * anthropic — OAuth file at `~/.claude/.credentials.json`
    //     (maintained by the Claude CLI).
    //   * openai    — OAuth file at `~/.codex/auth.json`
    //     (maintained by the Codex CLI).
    //   * openrouter / zai — API key in the macOS Keychain blob keyed by
    //     vendor slug (per Story 1.20 — `MacKeychainStore` /
    //     `ffi_keychain_get_blob`). Multi-account vendors use the active
    //     account (the in-memory active map, default = first account).
    //
    // SECURITY: no credential material crosses this FFI surface as
    // `string`. The function takes a `vendor_name` slug only; the secret
    // never leaves the Rust side.
    //
    // `[Async]` lets the future drive the HTTP request without blocking
    // the Swift main thread. The Rust implementation wraps the inner work
    // in `async_compat::Compat` so `reqwest`/`tokio::time` find a tokio
    // context inside UniFFI's UDL-mode polling driver (same pattern as
    // `InsightsClient::request_insight_streaming` — Story 1.15).
    [Async, Throws=RefreshFfiError]
    void ffi_refresh_vendor(string vendor_name);

    // Story 4.6 (Wave 4) — Budget burn aggregation.
    //
    // Reads the `[budgets]` section from `~/.config/torven/config.toml` and
    // aggregates `usage_snapshots` for the current calendar month (UTC). All
    // computation happens Rust-side so Swift consumes a single pre-shaped
    // value — no client-side aggregation.
    //
    // Fast path: when no `[budgets]` is configured, returns `has_budget =
    // false` and zeroed totals WITHOUT issuing the SQLite aggregation query
    // (AC-4 optimisation). The SwiftUI `BudgetBurn` view inspects
    // `has_budget` and renders `EmptyView()` in that case.
    //
    // Synchronous (no `[Async]`): the SQLite aggregation for a month of
    // snapshots is fast (< 50ms even at NFR-1 worst-case ~43k events)
    // because the query uses indexed `(vendor, ts)` lookups. Swift wraps
    // the call in a `Task { }` like every other FFI in the chart pipeline.
    //
    // Errors are intentionally NOT exposed via `[Throws=...]`: a config
    // parse failure or SQLite I/O error in this surface degrades to
    // `has_budget = false` server-side so the gauge gracefully disappears
    // (warning is emitted via `tracing::warn!` for diagnostics).
    BudgetStatus get_budget_status();
};
